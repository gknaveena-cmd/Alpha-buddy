<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Alpha Buddy — English Learning V1</title>
<style>
:root{--ink:#20304a;--muted:#69758b;--bg:#f5f8ff;--purple:#6c4cf1;--gold:#ffcb55;--green:#2ba879;--red:#e94e68}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(160deg,#f6f3ff,#eefaff);font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink)}
header{background:#fff;position:sticky;top:0;z-index:5;border-bottom:1px solid #e8eaf4;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.brand{font-weight:900;font-size:19px}.brand span{color:var(--purple)}.stats{display:flex;gap:8px;flex-wrap:wrap}.pill{background:#f2f0ff;border-radius:30px;padding:7px 11px;font-weight:800;font-size:13px}.heart{color:#e94e68}
main{max-width:900px;margin:auto;padding:18px 14px 60px}.hero{background:linear-gradient(135deg,#7658ff,#4f8dff);color:white;border-radius:26px;padding:22px;box-shadow:0 12px 30px #5c62cb25}.hero h1{font-size:clamp(25px,5vw,38px);margin:4px 0 8px}.hero p{line-height:1.5;margin:0}.bear{font-size:54px;float:right;margin:0 4px 8px 12px}.small{font-size:13px;opacity:.9}.progresswrap{height:10px;background:#e8eaf4;border-radius:20px;overflow:hidden;margin-top:13px}.progress{height:100%;width:0;background:var(--gold);transition:width .2s}
.sectionhead{display:flex;justify-content:space-between;align-items:end;gap:10px;margin:22px 2px 12px}.sectionhead h2{margin:0;font-size:22px}.sectionhead p{margin:3px 0 0;color:var(--muted);font-size:13px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.stage{background:white;border:2px solid #e8eaf5;border-radius:20px;padding:15px;text-align:left;box-shadow:0 4px 14px #24385b08}.stage h3{margin:6px 0;font-size:16px}.stage p{margin:0 0 12px;color:var(--muted);font-size:13px}.stage .meta{font-size:12px;font-weight:800;color:var(--purple)}.stage button,.btn{border:0;border-radius:13px;padding:11px 14px;font-weight:850;background:var(--purple);color:white;cursor:pointer;width:100%}.stage button:disabled{background:#c8cbd8;color:#686d7b;cursor:not-allowed}.stage.done{border-color:#7dd7b2}.stage.locked{opacity:.72}
.panel{background:white;border-radius:24px;padding:20px;margin-top:18px;box-shadow:0 8px 26px #24385b10}.hidden{display:none!important}.row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.eyebrow{color:var(--purple);font-weight:900;text-transform:uppercase;letter-spacing:.08em;font-size:12px}.question{font-size:clamp(20px,4vw,28px);font-weight:900;line-height:1.3;margin:14px 0 18px}.answers{display:grid;grid-template-columns:1fr 1fr;gap:10px}.answer-row{display:flex;gap:6px;min-width:0}.answer-row .answer{flex:1;min-width:0}.speak-btn{border:2px solid #e2e5f0;background:#f5f3ff;color:var(--purple);border-radius:12px;padding:8px 11px;font-size:18px;cursor:pointer}.speak-btn:hover{background:#e9e4ff}.listen-question{display:inline-flex;align-items:center;gap:7px;margin:-6px 0 14px;padding:9px 13px;border:0;border-radius:12px;background:#f2f0ff;color:var(--purple);font-weight:800;cursor:pointer}.answer{padding:14px;border:2px solid #e2e5f0;background:#fff;border-radius:15px;font-size:15px;font-weight:750;text-align:left;color:var(--ink);cursor:pointer}.answer:hover:not(:disabled){border-color:var(--purple);background:#f8f6ff}.answer:disabled{cursor:default}.answer.correct{border-color:var(--green);background:#eafaf3}.answer.wrong{border-color:var(--red);background:#fff0f2}.feedback{margin-top:14px;border-radius:14px;padding:12px;font-weight:700;line-height:1.4}.feedback.good{background:#e8fbf2;color:#176e4d}.feedback.bad{background:#fff0f2;color:#a32640}.actions{display:flex;gap:10px;margin-top:16px}.actions button{flex:1}.secondary{background:#eef0f8!important;color:var(--ink)!important}.danger{background:#fff0f2!important;color:#a32640!important}.lockscreen{text-align:center;padding:26px 12px}.lockscreen .big{font-size:60px}.lockscreen h2{font-size:28px;margin:8px}.lockscreen p{color:var(--muted);line-height:1.5}.timer{font-weight:900;color:var(--red)}.notice{background:#fff8df;border:1px solid #ffe5a0;border-radius:14px;padding:12px;margin-top:14px;font-size:13px;line-height:1.5}.badge{display:inline-block;background:#f2f0ff;color:var(--purple);padding:5px 9px;border-radius:30px;font-size:12px;font-weight:900}
@media(max-width:540px){.answers{grid-template-columns:1fr}.hero{padding:18px}.bear{font-size:42px}.panel{padding:16px}.stats{gap:5px}.pill{padding:6px 8px}}

/* Alpha Buddy Adventure visual upgrade */
body{background:radial-gradient(ellipse at 10% 0%,#e9e2ff 0,transparent 38%),radial-gradient(ellipse at 95% 20%,#d8f7ff 0,transparent 35%),linear-gradient(160deg,#f8f6ff,#f0fbff);background-attachment:fixed}
header{background:rgba(255,255,255,.88);backdrop-filter:blur(16px);box-shadow:0 5px 25px #33276b0b;border-bottom:1px solid #ffffff}
.brand{letter-spacing:-.5px}.brand span{background:linear-gradient(90deg,#7451f5,#ff4fa0);-webkit-background-clip:text;background-clip:text;color:transparent}
.pill{box-shadow:0 3px 9px #382c7710;border:1px solid #ffffff}
.hero{position:relative;overflow:hidden;border:1px solid #ffffff80;background:linear-gradient(125deg,#714cf5 0%,#8064ff 44%,#36a8ed 100%);box-shadow:0 18px 38px #6447d52b}
.hero:before{content:"";position:absolute;width:230px;height:230px;border:1px solid #ffffff35;border-radius:50%;right:-55px;top:-90px;box-shadow:0 0 0 22px #ffffff0b,0 0 0 45px #ffffff0b}
.hero:after{content:"✦  ✧  ✦";position:absolute;right:22px;bottom:15px;font-size:22px;letter-spacing:13px;color:#ffffff8a}
.bear{position:relative;z-index:1;filter:drop-shadow(0 8px 5px #2c246d38);animation:bob 3s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-7px) rotate(3deg)}}
.hero-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:15px;position:relative;z-index:1}.hero-tags span{font-size:12px;font-weight:850;background:#ffffff22;border:1px solid #ffffff55;padding:7px 10px;border-radius:999px}
.progresswrap{background:#dfe4f5;box-shadow:inset 0 2px 4px #24385b0b}.progress{background:linear-gradient(90deg,#ffd86a,#fff09a);border-radius:20px;box-shadow:0 0 12px #ffe67b88}
.stage{position:relative;overflow:hidden;border:1px solid #e6e6f5;box-shadow:0 7px 20px #2d32630a;transition:transform .18s,box-shadow .18s,border-color .18s}
.stage:before{content:"";position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,#8a6bff,#46c5e9);opacity:.65}
.stage:hover{transform:translateY(-4px);box-shadow:0 13px 26px #5e4dc51b;border-color:#b9adff}
.stage.done:before{background:linear-gradient(90deg,#35c88b,#a3e7b9);opacity:1}
.stage.locked{background:linear-gradient(140deg,#fff,#f6f7fc)}
.stage .meta{letter-spacing:.04em}
.stage button{box-shadow:0 4px 0 #4d35bd;transition:transform .1s,box-shadow .1s}.stage button:active,.btn:active{transform:translateY(2px);box-shadow:none}
.stage button:disabled{box-shadow:none}
.panel{border:1px solid #fff;box-shadow:0 14px 34px #34456d12}
.answer{transition:transform .12s,border-color .12s,background .12s;box-shadow:0 3px 0 #e5e7f0}
.answer:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 5px 0 #ded7ff}
.answer.correct{box-shadow:0 3px 0 #a6e8c9}.answer.wrong{box-shadow:0 3px 0 #ffc2cb}
.btn{box-shadow:0 4px 0 #4d35bd;transition:transform .1s,box-shadow .1s}.btn.secondary{box-shadow:0 4px 0 #dce0ec}
.badge{border:1px solid #e6ddff}
.notice{box-shadow:0 5px 16px #d6ac3220}
@media(prefers-reduced-motion:reduce){.bear,.stage,.answer{animation:none;transition:none}}


.language-panel{margin-top:18px}.language-controls{display:grid;grid-template-columns:1fr auto;gap:10px;margin-top:12px}.language-controls select{min-width:0;border:2px solid #e5e7f0;border-radius:13px;padding:12px;background:#fff;color:#20304a;font:inherit;font-weight:750}.language-hint{font-size:13px;color:#69758b;line-height:1.5}.language-panel .btn{width:auto}@media(max-width:520px){.language-controls{grid-template-columns:1fr}.language-panel .btn{width:100%}}

.hero-logo{display:block;width:min(100%,320px);height:auto;margin:0 auto 18px;border-radius:18px;box-shadow:0 12px 28px #18275c45;position:relative;z-index:1}
@media(max-width:540px){.hero-logo{width:min(100%,280px);margin-bottom:14px}}
</style></head><body>
